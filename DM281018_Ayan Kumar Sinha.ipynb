    "# E4: Overtime Reliance and Compensation Structure\n",
    "top5_agencies = ['POLICE DEPARTMENT', 'FIRE DEPARTMENT', 'DEPARTMENT OF CORRECTION', 'DEPARTMENT OF SANITATION', 'NYC HOUSING AUTHORITY']\n",
    "pos_comp_mask = (df['Regular Gross Paid'] > 0) & (df['Total OT Paid'] > 0)\n",
    "df_comp = df.loc[pos_comp_mask, ['Agency_Name_Clean', 'Regular Gross Paid', 'Total OT Paid', 'Total Other Pay']].copy()\n",
    "total_evaluated = len(df_comp)\n",
    "\n",
    "# Metric 1: Overtime Reliance Ratio = Total OT Paid / Total Gross Compensation\n",
    "df_comp['Total_Gross_Comp'] = (df_comp['Regular Gross Paid'] + df_comp['Total OT Paid'] + df_comp['Total Other Pay'].fillna(0)).round(2)\n",
    "valid_denom_mask = (df_comp['Total_Gross_Comp'] > 0) & np.isfinite(df_comp['Total_Gross_Comp'])\n",
    "excluded_count = int((~valid_denom_mask).sum())\n",
    "df_m1 = df_comp[valid_denom_mask].copy()\n",
    "\n",
    "df_m1['OT_Reliance_Ratio'] = df_m1['Total OT Paid'] / df_m1['Total_Gross_Comp']\n",
    "finite_ratio_mask = np.isfinite(df_m1['OT_Reliance_Ratio'])\n",
    "df_m1 = df_m1[finite_ratio_mask].copy()\n",
    "\n",
    "reliance_stats = df_m1['OT_Reliance_Ratio'].describe(percentiles=[0.01, 0.05, 0.10, 0.25, 0.50, 0.75, 0.90, 0.95, 0.99])\n",
    "final_m1_count = len(df_m1)\n",
    "\n",
    "# Metric 2: Overtime as a percentage of Regular Gross Pay (Independent calculation)\n",
    "df_comp['OT_to_Regular_Pct'] = (df_comp['Total OT Paid'] / df_comp['Regular Gross Paid']) * 100\n",
    "ot_reg_stats = df_comp['OT_to_Regular_Pct'].describe(percentiles=[0.01, 0.05, 0.10, 0.25, 0.50, 0.75, 0.90, 0.95, 0.99])\n",
