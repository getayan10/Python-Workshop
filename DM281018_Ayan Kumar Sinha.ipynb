    "# A3: Complete Data Dictionary Construction\n",
    "data_dict = pd.DataFrame([\n",
    "    {\"Column\": \"Fiscal Year\", \"Plain-English Meaning\": \"Municipal accounting fiscal year (July 1 to June 30)\", \"Pandas Dtype\": \"int16\", \"Classification\": \"Temporal Identifier\", \"Example Value\": \"2024\", \"Caveats\": \"Spans FY2014 through FY2025; captures full fiscal periods.\"},\n",
    "    {\"Column\": \"Payroll Number\", \"Plain-English Meaning\": \"Internal municipal payroll accounting code\", \"Pandas Dtype\": \"object\", \"Classification\": \"Administrative Identifier\", \"Example Value\": \"56.0\", \"Caveats\": \"Administrative accounting code; missing in 33.87% of records; omitted from modeling.\"},\n",
    "    {\"Column\": \"Agency Name\", \"Plain-English Meaning\": \"Municipal agency or operational entity name\", \"Pandas Dtype\": \"object\", \"Classification\": \"Categorical Dimension\", \"Example Value\": \"POLICE DEPARTMENT\", \"Caveats\": \"Contains casing variants (e.g. Police Department vs POLICE DEPARTMENT) requiring normalization.\"},\n",
    "    {\"Column\": \"Last Name\", \"Plain-English Meaning\": \"Employee surname\", \"Pandas Dtype\": \"object\", \"Classification\": \"Identifier (PII)\", \"Example Value\": \"DOE\", \"Caveats\": \"Redacted/masked as DOE in >4.38M records for undercover and public safety personnel.\"},\n",
    "    {\"Column\": \"First Name\", \"Plain-English Meaning\": \"Employee given name\", \"Pandas Dtype\": \"object\", \"Classification\": \"Identifier (PII)\", \"Example Value\": \"JOHN\", \"Caveats\": \"Similarly redacted; individual longitudinal tracking is not supported by dataset design.\"},\n",
    "    {\"Column\": \"Mid Init\", \"Plain-English Meaning\": \"Employee middle initial\", \"Pandas Dtype\": \"object\", \"Classification\": \"Identifier (PII)\", \"Example Value\": \"M\", \"Caveats\": \"Missing in 40.63% of records; non-analytical attribute.\"},\n",
    "    {\"Column\": \"Agency Start Date\", \"Plain-English Meaning\": \"Date employee commenced service at reporting agency\", \"Pandas Dtype\": \"object\", \"Classification\": \"Temporal Attribute\", \"Example Value\": \"07/16/2007\", \"Caveats\": \"Represents current agency start date, not total citywide civil service seniority.\"},\n",
    "    {\"Column\": \"Work Location Borough\", \"Plain-English Meaning\": \"Borough of primary administrative/work assignment\", \"Pandas Dtype\": \"object\", \"Classification\": \"Spatial Dimension\", \"Example Value\": \"MANHATTAN\", \"Caveats\": \"Missing in 7.47% of records (categorized as NOT REPORTED); indicates reporting station, not residence.\"},\n",
    "    {\"Column\": \"Title Description\", \"Plain-English Meaning\": \"Formal civil service job title or occupational role\", \"Pandas Dtype\": \"object\", \"Classification\": \"Categorical Dimension\", \"Example Value\": \"CHIEF MARINE ENGINEER\", \"Caveats\": \"Standardized civil service titles; missing in 129 records (<0.002%).\"},\n",
    "    {\"Column\": \"Leave Status as of June 30\", \"Plain-English Meaning\": \"Employment status at fiscal year close\", \"Pandas Dtype\": \"object\", \"Classification\": \"Categorical Dimension\", \"Example Value\": \"ACTIVE\", \"Caveats\": \"Categories: ACTIVE, CEASED, ON LEAVE, SEASONAL; reflects point-in-time status.\"},\n",
    "    {\"Column\": \"Base Salary\", \"Plain-English Meaning\": \"Contractual baseline rate of pay\", \"Pandas Dtype\": \"float64\", \"Classification\": \"Numerical Attribute\", \"Example Value\": \"169520.00\", \"Caveats\": \"Unit varies by Pay Basis (Annual, Daily, Hourly); incommensurable without pay basis segmentation.\"},\n",
    "    {\"Column\": \"Pay Basis\", \"Plain-English Meaning\": \"Remuneration basis schedule\", \"Pandas Dtype\": \"object\", \"Classification\": \"Categorical Dimension\", \"Example Value\": \"Per Annum\", \"Caveats\": \"Categories: Per Annum, Per Day, Per Hour, Prorated Annual; governs interpretation of Base Salary.\"},\n",
    "    {\"Column\": \"Regular Hours\", \"Plain-English Meaning\": \"Total standard non-overtime hours logged in fiscal year\", \"Pandas Dtype\": \"float64\", \"Classification\": \"Effort Metric\", \"Example Value\": \"2080.00\", \"Caveats\": \"Standard full-time annual benchmark is 2,080 hours (or 1,820 for 35-hr workweeks).\"},\n",
    "    {\"Column\": \"Regular Gross Paid\", \"Plain-English Meaning\": \"Total base compensation earned during fiscal year\", \"Pandas Dtype\": \"float64\", \"Classification\": \"Numerical Attribute\", \"Example Value\": \"167584.22\", \"Caveats\": \"Includes negative retroactive adjustments; serves as denominator for overtime reliance.\"},\n",
    "    {\"Column\": \"OT Hours\", \"Plain-English Meaning\": \"Total overtime hours worked in fiscal year\", \"Pandas Dtype\": \"float64\", \"Classification\": \"Effort Metric\", \"Example Value\": \"1005.50\", \"Caveats\": \"Contains 917 negative adjustment records; zero in 75.12% of records; key correlate of OT Paid.\"},\n",
    "    {\"Column\": \"Total OT Paid\", \"Plain-English Meaning\": \"Total gross overtime compensation disbursed\", \"Pandas Dtype\": \"float64\", \"Classification\": \"Primary Target Variable\", \"Example Value\": \"527532.01\", \"Caveats\": \"Primary variable; continuous nominal USD; contains 3,680 negative accounting entries.\"},\n",
    "    {\"Column\": \"Total Other Pay\", \"Plain-English Meaning\": \"Supplementary pay (differentials, hazard pay, retro)\", \"Pandas Dtype\": \"float64\", \"Classification\": \"Numerical Attribute\", \"Example Value\": \"12500.00\", \"Caveats\": \"Contains large negative offsets causing Total Gross Compensation to be <= 0 in 368 records.\"}\n",
