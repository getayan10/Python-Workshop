    "axes_d1[1].axvline(rate_stats['mean'], color='blue', linestyle='-', label=f\"Mean: ${rate_stats['mean']:.2f}/hr\")\n",
    "axes_d1[1].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
