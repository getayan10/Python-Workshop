    "    Median_OT_Hours=('OT Hours', 'median'),\n",
    "    Mean_OT_Paid=('Total OT Paid', 'mean'),\n",
    "    Median_OT_Paid=('Total OT Paid', 'median'),\n",
    "    Implied_Hourly_Rate=('Total OT Paid', lambda x: (x / df_pos_e1.loc[x.index, 'OT Hours']).median())\n",
    ").reset_index()\n",
    "\n",
    "e1_table['Record_Share (%)'] = (e1_table['Record_Count'] / len(df_pos_e1)) * 100\n",
