   "source": [
    "# Setup Cell 2: Memory-Conscious Data Ingestion via Pandas Chunk Processing\n",
    "print(\"Starting dataset ingestion in 1,000,000-row chunks...\")\n",
    "t_start = time.time()\n",
    "\n",
    "num_cols = ['Base Salary', 'Regular Gross Paid', 'OT Hours', 'Total OT Paid', 'Total Other Pay', 'Regular Hours']\n",
    "chunks = []\n",
    "raw_record_count = 0\n",
    "\n",
    "for i, chunk in enumerate(pd.read_csv(DATA_PATH, chunksize=1000000, dtype=str)):\n",
    "    raw_record_count += len(chunk)\n",
    "    for col in num_cols:\n",
    "        chunk[col] = pd.to_numeric(chunk[col].str.replace('$', '', regex=False).str.replace(',', '', regex=False).str.strip(), errors='coerce')\n",
    "    chunk['Fiscal Year'] = chunk['Fiscal Year'].astype('int16')\n",
    "    chunks.append(chunk)\n",
    "    print(f\"  Chunk {i+1} processed: {raw_record_count:,} total records ingested\")\n",
    "\n",
    "df_raw = pd.concat(chunks, ignore_index=True)\n",
    "raw_shape = df_raw.shape\n",
    "elapsed = time.time() - t_start\n",
    "\n",
    "print(f\"\\nRaw Ingestion Complete: {raw_shape[0]:,} rows x {raw_shape[1]} columns in {elapsed:.1f}s\")\n",
    "print(f\"Estimated Memory Footprint: {df_raw.memory_usage(deep=True).sum() / (1024**2):.2f} MB\")"
   ]
