   "source": [
    "# D1: Numerical x Numerical Correlation and Implied Hourly Rate\n",
    "# 1. Pearson and Spearman Correlation\n",
    "p_r_all, p_p_all = stats.pearsonr(df['OT Hours'].fillna(0), df['Total OT Paid'].fillna(0))\n",
    "s_r_all, s_p_all = stats.spearmanr(df['OT Hours'].fillna(0), df['Total OT Paid'].fillna(0))\n",
    "\n",
    "pos_mask = (df['OT Hours'] > 0) & (df['Total OT Paid'] > 0)\n",
    "df_pos = df[pos_mask].copy()\n",
    "p_r_pos, p_p_pos = stats.pearsonr(df_pos['OT Hours'], df_pos['Total OT Paid'])\n",
    "s_r_pos, s_p_pos = stats.spearmanr(df_pos['OT Hours'], df_pos['Total OT Paid'])\n",
    "\n",
    "print(\"=== Correlation Analysis (Total OT Paid vs. OT Hours) ===\")\n",
    "print(f\"Across All Records (including zeros):\")\n",
    "print(f\"  Pearson Correlation:  r   = {p_r_all:.4f} (p-value: {p_p_all:.4e})\")\n",
    "print(f\"  Spearman Correlation: rho = {s_r_all:.4f} (p-value: {s_p_all:.4e})\")\n",
    "print(f\"\\nAmong Positive Overtime Recipients (n = {len(df_pos):,}):\")\n",
    "print(f\"  Pearson Correlation:  r   = {p_r_pos:.4f} (p-value: {p_p_pos:.4e})\")\n",
    "print(f\"  Spearman Correlation: rho = {s_r_pos:.4f} (p-value: {s_p_pos:.4e})\")\n",
    "\n",
    "# 2. Implied Overtime Hourly Rate Distribution\n",
    "df_pos['Implied_Hourly_Rate'] = df_pos['Total OT Paid'] / df_pos['OT Hours']\n",
    "rate_stats = df_pos['Implied_Hourly_Rate'].describe(percentiles=[0.05, 0.25, 0.50, 0.75, 0.95])\n",
    "print(\"\\n=== Implied Overtime Hourly Rate Distribution ($/Hour) ===\")\n",
    "print(f\"  5th Percentile:  ${rate_stats['5%']:.2f}/hr\")\n",
    "print(f\"  25th Percentile: ${rate_stats['25%']:.2f}/hr\")\n",
    "print(f\"  50th Percentile (Median): ${rate_stats['50%']:.2f}/hr\")\n",
    "print(f\"  75th Percentile: ${rate_stats['75%']:.2f}/hr\")\n",
    "print(f\"  95th Percentile: ${rate_stats['95%']:.2f}/hr\")\n",
    "print(f\"  Mean Implied Rate: ${rate_stats['mean']:.2f}/hr\")\n",
    "# Visualization: Hexbin Density and Implied Rate Distribution\n",
    "fig_d1, axes_d1 = plt.subplots(1, 2, figsize=(16, 5))\n",
    "sub_sample = df[(df['OT Hours'] > 0) & (df['Total OT Paid'] > 0)].sample(n=50000, random_state=42)\n",
    "\n",
    "hb = axes_d1[0].hexbin(sub_sample['OT Hours'], sub_sample['Total OT Paid'], gridsize=40, cmap='Blues', mincnt=1, bins='log')\n",
    "axes_d1[0].set_title('Figure D1a: OT Paid vs. OT Hours (Hexbin Density, n=50,000 Sample)', fontweight='bold')\n",
    "axes_d1[0].set_xlabel('Overtime Hours')\n",
    "axes_d1[0].set_ylabel('Total Overtime Paid ($)')\n",
    "axes_d1[0].yaxis.set_major_formatter(ticker.StrMethodFormatter('${x:,.0f}'))\n",
    "cb = fig_d1.colorbar(hb, ax=axes_d1[0])\n",
    "cb.set_label('Log10(Count)')\n",
    "\n",
    "rate_s = df_pos['Implied_Hourly_Rate']\n",
    "sns.histplot(rate_s.clip(0, 150), bins=60, kde=True, color='#2ca02c', ax=axes_d1[1])\n",
    "axes_d1[1].set_title('Figure D1b: Distribution of Implied Hourly Overtime Rate ($/hr)', fontweight='bold')\n",
