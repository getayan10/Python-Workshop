    "df_pos_e1['Regular_Pay_Tier'] = pd.cut(df_pos_e1['Regular Gross Paid'], bins=bins, labels=labels)\n",
    "\n",
    "e1_table = df_pos_e1.groupby('Regular_Pay_Tier').agg(\n",
    "    Record_Count=('Total OT Paid', 'count'),\n",
    "    Mean_Regular_Pay=('Regular Gross Paid', 'mean'),\n",
