   "source": [
    "# B4: Formal IQR Outlier Detection\n",
    "def calculate_iqr_fences(series, name):\n",
    "    valid_s = series.dropna()\n",
    "    q1 = valid_s.quantile(0.25)\n",
    "    q3 = valid_s.quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "    lower_fence = q1 - 1.5 * iqr\n",
    "    upper_fence = q3 + 1.5 * iqr\n",
    "    below_lower = (valid_s < lower_fence).sum()\n",
    "    above_upper = (valid_s > upper_fence).sum()\n",
    "    total_outliers = below_lower + above_upper\n",
    "    return {\n",
    "        'Variable': name,\n",
    "        'Count': len(valid_s),\n",
    "        'Q1 (25%)': q1,\n",
    "        'Q3 (75%)': q3,\n",
    "        'IQR': iqr,\n",
    "        'Lower Fence': lower_fence,\n",
    "        'Upper Fence': upper_fence,\n",
    "        'Outliers Below': below_lower,\n",
    "        'Outliers Above': above_upper,\n",
    "        'Total Outliers': total_outliers,\n",
    "        'Outlier Pct (%)': (total_outliers / len(valid_s)) * 100\n",
    "    }\n",
    "\n",
    "iqr_results = pd.DataFrame([\n",
    "    calculate_iqr_fences(df['Total OT Paid'], 'Total OT Paid (All Records)'),\n",
    "    calculate_iqr_fences(df[df['Total OT Paid'] > 0]['Total OT Paid'], 'Total OT Paid (Positive Cohort)'),\n",
    "    calculate_iqr_fences(df['OT Hours'], 'OT Hours (All Records)'),\n",
    "    calculate_iqr_fences(df[df['OT Hours'] > 0]['OT Hours'], 'OT Hours (Positive Cohort)'),\n",
    "    calculate_iqr_fences(df[df['Pay_Basis_Clean'] == 'Per Annum']['Base Salary'], 'Base Salary (Per Annum)')\n",
    "])\n",
    "\n",
    "print(\"=== IQR Outlier Summary Table ===\")\n",
    "print(iqr_results.to_string(index=False))\n",
    "\n",
    "print(\"\\n=== Extreme Overtime Payments (> $200,000) ===\")\n",
