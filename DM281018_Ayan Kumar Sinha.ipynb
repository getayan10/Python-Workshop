   "source": [
    "# Setup Cell 3: Deduplication and Creation of Clean Analytical Dataset\n",
    "exact_duplicates_count = int(df_raw.duplicated().sum())\n",
    "dup_count = exact_duplicates_count\n",
    "print(f\"Exact Duplicate Records Detected across all 17 columns: {exact_duplicates_count:,}\")\n",
    "\n",
    "# Eliminate exact duplicates to establish authoritative analytical population\n",
    "df = df_raw.drop_duplicates().copy()\n",
    "analytical_shape = df.shape\n",
    "\n",
    "# Apply standardized categorical transformations\n",
    "df['Pay_Basis_Clean'] = df['Pay Basis'].astype(str).str.strip().str.title()\n",
    "df['Agency_Name_Clean'] = df['Agency Name'].astype(str).str.strip().str.upper().str.replace(r'\\s+', ' ', regex=True)\n",
    "df['Leave_Status_Clean'] = df['Leave Status as of June 30'].astype(str).str.strip().str.upper()\n",
    "\n",
    "nyc_boroughs = {'MANHATTAN': 'MANHATTAN', 'QUEENS': 'QUEENS', 'BROOKLYN': 'BROOKLYN', 'BRONX': 'BRONX', 'RICHMOND': 'RICHMOND / STATEN ISLAND'}\n",
    "def clean_borough(val):\n",
    "    if pd.isna(val) or str(val).strip() == '' or str(val).strip().upper() == 'NAN':\n",
    "        return 'NOT REPORTED'\n",
    "    s = str(val).strip().upper()\n",
    "    if s in nyc_boroughs:\n",
    "        return nyc_boroughs[s]\n",
    "    if 'OTHER' in s or 'WESTCHESTER' in s or 'NASSAU' in s or 'OUTSIDE' in s:\n",
    "        return 'OTHER'\n",
    "    return 'NOT REPORTED'\n",
    "\n",
    "df['Borough_Clean'] = df['Work Location Borough'].apply(clean_borough)\n",
    "\n",
    "print(f\"Final Clean Analytical Records: {analytical_shape[0]:,} rows x {analytical_shape[1]} columns\")\n",
    "print(f\"Retention Rate: {analytical_shape[0] / raw_shape[0] * 100:.4f}%\")"
   ]
