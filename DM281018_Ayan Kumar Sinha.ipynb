   "source": [
    "# E2: Two Numerical x One Categorical Regression Parameters\n",
    "e2_results = []\n",
    "for pb in ['Per Annum', 'Per Day', 'Per Hour', 'Prorated Annual']:\n",
    "    sub = df[(df['Pay_Basis_Clean'] == pb) & (df['OT Hours'] > 0) & (df['Total OT Paid'] > 0)]\n",
    "    r_val, p_val = stats.pearsonr(sub['OT Hours'], sub['Total OT Paid'])\n",
    "    rho_val, _ = stats.spearmanr(sub['OT Hours'], sub['Total OT Paid'])\n",
    "    rate_s = sub['Total OT Paid'] / sub['OT Hours']\n",
    "    e2_results.append({\n",
    "        'Pay Basis': pb,\n",
    "        'Recipient Records': len(sub),\n",
    "        'Mean OT Hours': sub['OT Hours'].mean(),\n",
    "        'Mean OT Paid': sub['Total OT Paid'].mean(),\n",
    "        'Pearson r': r_val,\n",
    "        'Spearman rho': rho_val,\n",
    "        'Median Implied Rate ($/hr)': rate_s.median(),\n",
    "        'IQR Rate ($/hr)': rate_s.quantile(0.75) - rate_s.quantile(0.25)\n",
    "    })\n",
    "\n",
    "e2_table = pd.DataFrame(e2_results)\n",
    "print(\"=== E2: Linear Relationship Parameters by Pay Basis ===\")\n",
    "print(e2_table.to_string(index=False, formatters={\n",
    "    'Recipient Records': '{:,}'.format,\n",
    "    'Mean OT Hours': '{:.1f}'.format,\n",
    "    'Mean OT Paid': '${:,.2f}'.format,\n",
    "    'Pearson r': '{:.4f}'.format,\n",
    "    'Spearman rho': '{:.4f}'.format,\n",
    "    'Median Implied Rate ($/hr)': '${:,.2f}'.format,\n",
    "    'IQR Rate ($/hr)': '${:,.2f}'.format\n",
    "}))\n",
    "# Visualization: Pay Basis Regression Slopes\n",
    "fig_e2, axes_e2 = plt.subplots(1, 2, figsize=(16, 5))\n",
    "sub_pa = df[(df['Pay_Basis_Clean'] == 'Per Annum') & (df['OT Hours'] > 0) & (df['Total OT Paid'] > 0)].sample(n=25000, random_state=42)\n",
    "sub_pd = df[(df['Pay_Basis_Clean'] == 'Per Day') & (df['OT Hours'] > 0) & (df['Total OT Paid'] > 0)].sample(n=25000, random_state=42)\n",
    "\n",
    "sns.regplot(data=sub_pa, x='OT Hours', y='Total OT Paid', scatter_kws={'alpha': 0.2, 's': 8}, line_kws={'color': 'red', 'linewidth': 2}, ax=axes_e2[0])\n",
    "axes_e2[0].set_title('Figure E2a: Per Annum Overtime vs. Hours (Slope = $59.41/hr)', fontweight='bold')\n",
    "axes_e2[0].set_xlabel('Overtime Hours')\n",
    "axes_e2[0].set_ylabel('Total Overtime Paid ($)')\n",
