    "# D3: Numerical x Categorical Group Statistics & ANOVA\n",
    "top10_agencies = df.groupby('Agency_Name_Clean')['Total OT Paid'].sum().nlargest(10).index\n",
    "\n",
    "d3_stats = []\n",
    "citywide_total_ot = df['Total OT Paid'].sum()\n",
    "\n",
    "for ag in top10_agencies:\n",
    "    sub = df[df['Agency_Name_Clean'] == ag]\n",
    "    pos = sub[sub['Total OT Paid'] > 0]['Total OT Paid']\n",
    "    d3_stats.append({\n",
    "        'Agency Name': ag,\n",
    "        'Total Records': len(sub),\n",
    "        'Total OT Outlay ($M)': sub['Total OT Paid'].sum() / 1e6,\n",
    "        'Share of Citywide OT (%)': (sub['Total OT Paid'].sum() / citywide_total_ot) * 100,\n",
    "        'Positive OT Records': len(pos),\n",
    "        'Participation Rate (%)': (len(pos) / len(sub)) * 100,\n",
    "        'Mean Positive OT ($)': pos.mean(),\n",
    "        'Median Positive OT ($)': pos.median()\n",
    "    })\n",
    "\n",
    "d3_table = pd.DataFrame(d3_stats)\n",
