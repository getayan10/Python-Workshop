   "source": [
    "# D2: Categorical x Categorical Contingency & Chi-Square Test\n",
    "top5_agencies = ['POLICE DEPARTMENT', 'FIRE DEPARTMENT', 'DEPARTMENT OF CORRECTION', 'DEPARTMENT OF SANITATION', 'NYC HOUSING AUTHORITY']\n",
    "df_top5 = df[df['Agency_Name_Clean'].isin(top5_agencies)]\n",
    "\n",
    "contingency_counts = pd.crosstab(df_top5['Agency_Name_Clean'], df_top5['Pay_Basis_Clean'])\n",
    "contingency_row_pct = pd.crosstab(df_top5['Agency_Name_Clean'], df_top5['Pay_Basis_Clean'], normalize='index') * 100\n",
    "\n",
    "print(\"=== Contingency Table: Record Counts ===\")\n",
    "print(contingency_counts)\n",
    "\n",
    "print(\"\\n=== Contingency Table: Row Percentages (%) ===\")\n",
    "print(contingency_row_pct.round(2))\n",
    "\n",
    "# Chi-Square Test of Independence\n",
    "chi2, p_val, dof, expected = stats.chi2_contingency(contingency_counts)\n",
    "n_total = contingency_counts.values.sum()\n",
    "cramers_v = np.sqrt(chi2 / (n_total * (min(contingency_counts.shape) - 1)))\n",
    "\n",
    "print(\"\\n=== Chi-Square Test of Independence ===\")\n",
    "print(f\"Chi-Square Statistic (chi2): {chi2:,.2f}\")\n",
    "print(f\"Degrees of Freedom (dof):    {dof}\")\n",
    "print(f\"p-value:                     {p_val:.4e}\")\n",
    "print(f\"Cramer's V:                  {cramers_v:.4f}\")\n",
    "print(f\"Total Observations Tested:   {n_total:,}\")\n",
    "# Visualization: Agency x Pay Basis Heatmap\n",
    "fig_d2, ax_d2 = plt.subplots(figsize=(10, 5))\n",
    "sns.heatmap(contingency_row_pct, annot=True, fmt='.1f', cmap='YlGnBu', cbar_kws={'label': 'Row Percentage (%)'}, ax=ax_d2)\n",
    "ax_d2.set_title('Figure D2: Top 5 Agencies by Pay Basis Composition (Row Percentages)', fontweight='bold')\n",
    "ax_d2.set_xlabel('Cleaned Pay Basis')\n",
    "ax_d2.set_ylabel('Cleaned Agency Name')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
